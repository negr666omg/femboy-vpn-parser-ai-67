{
  "network": {
    "interface": "auto",
    "isolate_source_downloads": false
  },
  "sources": {
    "file": "sources.txt",
    "timeout": "30s"
  },
  "protocols": {
    "enabled": ["vless", "vmess", "trojan", "ss", "hysteria", "hysteria2", "tuic", "socks", "http"]
  },
  "url_test": {
    "url": "https://www.gstatic.com/generate_204",
    "concurrency": 8,
    "timeout": "12s"
  },
  "speed_test": {
    "provider": "cloudflare",
    "concurrency": 2,
    "timeout": "85s",
    "first_byte_timeout": "10s",
    "max_duration": "30s",
    "sample_interval": "500ms",
    "min_download_mbps": 8,
    "min_upload_mbps": 8,
    "download_bytes": 2097152,
    "upload_bytes": 2097152,
    "download_url": "https://speed.cloudflare.com/__down?bytes={bytes}",
    "upload_url": "https://speed.cloudflare.com/__up"
  },
  "service_check": {
    "concurrency": 4,
    "timeout": "25s",
    "lookup_ip": false,
    "rename_nodes": true,
    "geoip_url": "https://ipwho.is/",
    "name_format": "{flag} {country} {download}↓{upload}↑"
  },
  "output": {
    "directory": "out",
    "gemini_file": true
  },
  "remote_upload": {
    "enabled": false,
    "method": "sftp",
    "host": "example.com",
    "port": 22,
    "username": "ubuntu",
    "auth": "private_key",
    "private_key": "~/.ssh/id_ed25519",
    "password": "",
    "remote_directory": "/home/ubuntu/subwatch/out",
    "interface": ""
  }
}
